# Configuração do app (todas opcionais). O app não usa nenhuma credencial/segredo.
# Copie para o painel da plataforma de deploy ou exporte no shell antes de `python -m app`.

# Interface de rede: 127.0.0.1 (só esta máquina) ou 0.0.0.0 (aceita conexões externas; use em deploy).
HOST=0.0.0.0
# Porta HTTP (plataformas como Render/Railway/Heroku definem PORT automaticamente).
PORT=8000
# Caminho do arquivo SQLite. Em deploy, aponte para um disco/volume persistente.
GASTOS_DB_PATH=/data/gastos.db
